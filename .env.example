# Copy this file to .env.local and fill in the values. .env.local is never committed.

# PostgreSQL connection string, e.g. postgresql://adgen:password@localhost:5432/adgen
DATABASE_URL=

# Shopify (needed from step 4): your store and the app from the Shopify Dev Dashboard.
SHOPIFY_STORE_DOMAIN=yourstore.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only if your store has an old-style custom app with a fixed token (shpat_…); replaces the two above.
SHOPIFY_ADMIN_TOKEN=
# Optional: Shopify Admin API version (default 2026-10).
SHOPIFY_API_VERSION=

# Higgsfield (console.higgsfield.ai → API keys), written as KEY_ID:KEY_SECRET.
HIGGSFIELD_API_KEY=

# Dashboard login. ADMIN_PASSWORD: the password you type on /login (use a long one, the site is public).
# SESSION_SECRET: signs the login cookie; make one with: openssl rand -base64 32  (changing it logs everyone out)
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional settings (the defaults are shown).
# GENERATION_DRY_RUN=1 uses the real Shopify photo instead of a paid AI picture.
GENERATION_DRY_RUN=
# PUBLISH_DRY_RUN=1 only logs "would post". Defaults to on outside production, off in production.
PUBLISH_DRY_RUN=
# AUTO_CREATE_ADS_PER_WEEK=3 makes the worker choose products and make that many ads a week for Review (uses paid
# AI images unless GENERATION_DRY_RUN=1). Default 0 = off, most 10. Nothing is posted without someone approving it.
AUTO_CREATE_ADS_PER_WEEK=
# MAX_AD_COST_PER_SALE=150 is the most the client will pay in ads for one sale, in pounds. The advice on the Meta Ads page needs it.
MAX_AD_COST_PER_SALE=
# How far the autopilot may go by itself: advice (default), pause (also pauses poor ads), full (also launches ads and raises budgets).
# Only use pause or full with the client's written OK. Spending limits are in lib/paid-ads/promote.ts.
AUTOPILOT_LEVEL=
# AUTO_LAUNCH_WITHOUT_REVIEW=1: in full mode, launch ads that passed the automatic check without a person approving them.
AUTO_LAUNCH_WITHOUT_REVIEW=
# Claude key (console.anthropic.com) for the automatic ad check. Without it, a person is the only check.
ANTHROPIC_API_KEY=
# For real profit: VAT inside the store's prices (default 20), and a rough margin for items with no cost in Shopify.
VAT_PERCENT=
ROUGH_MARGIN_PERCENT=
# Slack or Discord incoming webhook for alerts and the weekly report.
ALERT_WEBHOOK_URL=
# A monitor such as healthchecks.io, pinged hourly, which raises the alarm if the worker stops.
HEALTHCHECK_PING_URL=
# HIGGSFIELD_MODEL=alibaba/qwen-image-3/edit
# POSTING_TIMEZONE=Europe/London
# STORAGE_DIR=storage

# Where approved ads are posted (default: instagram,facebook). Use "facebook" until Instagram is connected.
POST_PLATFORMS=

# Instagram + Facebook posting (from the client's Meta Business portfolio). Check with: npm run meta:check
# A System User token with pages_show_list, pages_read_engagement, pages_manage_posts,
# instagram_basic and instagram_content_publish, assigned to the Page and the Instagram account.
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
# Optional: a Page access token; otherwise it is fetched with META_ACCESS_TOKEN.
META_PAGE_ACCESS_TOKEN=
# Paid ads (the Meta Ads page). The ad account ID from Ads Manager (act_123… or just the number).
# The token above then also needs ads_management, and the System User needs the ad account assigned (Manage campaigns).
META_AD_ACCOUNT_ID=
# META_GRAPH_VERSION=v26.0
# The app's public https address. Meta downloads the post images from it, so it must be reachable from the internet.
PUBLIC_BASE_URL=
