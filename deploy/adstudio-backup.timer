# Runs adstudio-backup.service every night at 03:30 UTC, outside the 12:00 and 18:00 posting times.
[Unit]
Description=Ad Studio nightly backup

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
# If the server was off at 03:30, back up as soon as it is on again.
Persistent=true

[Install]
WantedBy=timers.target
